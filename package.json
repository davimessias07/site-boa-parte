{
  "name": "moveis-boa-parte",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning server/index.ts --port=3001",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -b",
    "sincronizar": "node --disable-warning=ExperimentalWarning server/sincronizar.ts",
    "exportar:vercel": "node --disable-warning=ExperimentalWarning server/exportar-vercel.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "fastify": "^5.12.5",
    "lucide-react": "^1.48.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "read-excel-file": "^9.3.10",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
